# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (PostGIS for coworking spaces, "payload" schema for the CMS)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# CMS: long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
PAYLOAD_SECRET=
# Public site URL, used for CSRF/CORS checks on the CMS
NEXT_PUBLIC_SITE_URL=https://otaglab.com
# Leave unset. Only set to true to allow the browser first-admin screen in production.
# CMS_ALLOW_FIRST_ADMIN=

# S3-compatible storage for coworking and CMS images
NEON_S3_BUCKET=
NEON_S3_REGION=auto
NEON_S3_ENDPOINT=
NEON_S3_ACCESS_KEY_ID=
NEON_S3_SECRET_ACCESS_KEY=

# Email (contact form and CMS password resets)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=otaglab.com
