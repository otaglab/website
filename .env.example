# Copy to .env.local for local development. Never commit real values.

# Neon Postgres (PostGIS for coworking spaces, "payload" schema for the CMS)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require

# CMS: long random string, e.g. `openssl rand -hex 32`. Changing it logs everyone out.
PAYLOAD_SECRET=
# Public site URL, used for CSRF/CORS checks on the CMS
NEXT_PUBLIC_SITE_URL=https://otaglab.com
# Leave unset. Only set to true to allow the browser first-admin screen in production.
# CMS_ALLOW_FIRST_ADMIN=

# Neon object storage (S3-compatible). The bucket is public; each space has its own folder.
AWS_ENDPOINT_URL_S3=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=workspace-gallery

# Google Drive access for the photo import (OAuth "Desktop app" client).
# Run `pnpm google:auth` once to sign in; it fills in GOOGLE_REFRESH_TOKEN.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Email (contact form and CMS password resets)
RESEND_API_KEY=
RESEND_EMAIL_DOMAIN=otaglab.com
